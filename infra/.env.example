# Copy to infra/.env and fill in. Never commit infra/.env.
POSTGRES_USER=docassistant
POSTGRES_PASSWORD=change-me
POSTGRES_DB=docassistant

# Encrypts provider API keys. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# Port the app is served on.
PROXY_PORT=8080

# Ollama: leave default for this project's own container (profile "ollama"),
# or point to the recipe app's Ollama, e.g. http://host.docker.internal:11434
OLLAMA_URL=http://ollama:11434
